<section class="notfound page-content">
  <p class="eyebrow">Próximamente</p>
  <h1 class="display">{{ shop.name }}</h1>
  {% if shop.password_message != blank %}
    <p class="rte">{{ shop.password_message }}</p>
  {% endif %}
  {% form 'storefront_password', class: 'search-form' %}
    {{ form.errors | default_errors }}
    <input type="password" name="password" aria-label="Contraseña" placeholder="Contraseña" autocomplete="current-password">
    <button class="btn btn--solid" type="submit">Entrar</button>
  {% endform %}
</section>
