<section aria-label="Llamado a la acción">
  <div class="cta-band reveal">
    <h2 class="display">{{ section.settings.heading }}</h2>
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--solid" href="{{ section.settings.button_link | default: '#catalogo' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Banda de llamado",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Únete al próximo drop antes de que se agote" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver catálogo completo" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Banda de llamado" }]
}
{% endschema %}
