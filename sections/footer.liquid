{%- assign cols = routes.collections_url -%}
<footer class="footer" id="contacto">
  <div class="footer__top">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="nav__logo">{{ settings.logo_text | default: 'DROP' }}<span>.</span></a>
      <p>{{ section.settings.about }}</p>
      {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank -%}
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div>
      <h4>Tienda</h4>
      <ul>
        <li><a href="{{ cols }}/calzado" data-veil="Calzado">Calzado</a></li>
        <li><a href="{{ cols }}/pantalones" data-veil="Pantalones">Pantalones</a></li>
        <li><a href="{{ cols }}/playeras" data-veil="Playeras">Playeras</a></li>
        <li><a href="{{ cols }}/camisas" data-veil="Camisas">Camisas</a></li>
        <li><a href="{{ cols }}/hombres" data-veil="Hombres" data-veil-figure="hombre">Hombres</a></li>
        <li><a href="{{ cols }}/mujeres" data-veil="Mujeres" data-veil-figure="mujer">Mujeres</a></li>
      </ul>
    </div>

    <div>
      <h4>Ayuda</h4>
      <ul>
        <li><a href="{{ routes.root_url }}#pedido">Hacer un pedido</a></li>
        {%- assign wa_text = settings.whatsapp_message | url_encode | replace: '+', '%20' -%}
        <li><a href="https://wa.me/{{ settings.whatsapp_number | strip }}?text={{ wa_text }}" target="_blank" rel="noopener" data-whatsapp>WhatsApp</a></li>
        {%- if settings.contact_email != blank -%}
          <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
        {%- endif -%}
        {%- for link in linklists['footer'].links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>

    <div>
      <h4>Avisos de nuevos drops</h4>
      {%- form 'customer', class: 'footer__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="tu@correo.com" aria-label="Correo electrónico" autocomplete="email" required value="{{ form.email }}">
        <button type="submit">Unirme</button>
        {%- if form.posted_successfully? -%}
          {%- assign newsletter_ok = true -%}
        {%- endif -%}
      {%- endform -%}
      {%- if newsletter_ok -%}
        <p class="footer__note" role="status">¡Gracias! Ya estás en la lista.</p>
      {%- endif -%}
    </div>
  </div>

  <div class="footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    {%- if shop.enabled_payment_types.size > 0 -%}
      <span class="footer__pay">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'icon-payment' }}
        {%- endfor -%}
      </span>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" style="text-decoration:none;color:inherit">Carrito</a>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    {
      "type": "textarea",
      "id": "about",
      "label": "Descripción",
      "default": "Ropa de marca, curada, enviada directo del proveedor a tu puerta. Sin bodega, sin relleno."
    },
    {
      "type": "paragraph",
      "content": "Los enlaces extra de \"Ayuda\" salen del menú con handle \"footer\" (Contenido → Menús)."
    }
  ]
}
{% endschema %}
