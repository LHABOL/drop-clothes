<section class="story" id="marcas">
  <div class="story__wrap">
    <div class="story__art reveal">
      <svg data-speed="0.5" viewBox="0 0 200 240" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
        <path d="M60 24 L80 10 L120 10 L140 24 L176 48 L152 84 L140 70 L140 226 L60 226 L60 70 L48 84 L24 48 Z"/>
        <path d="M80 10 C84 30 116 30 120 10"/>
        <line x1="100" y1="48" x2="100" y2="205"/>
        <circle cx="100" cy="120" r="26" stroke-dasharray="3 5"/>
      </svg>
    </div>
    <div class="story__copy reveal">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display">{{ section.settings.heading | escape | newline_to_br }}</h2>
      <p>{{ section.settings.text_1 }}</p>
      <p>{{ section.settings.text_2 }}</p>
      {%- if section.blocks.size > 0 -%}
        <div class="story__stats">
          {%- for block in section.blocks -%}
            <div class="story__stat" {{ block.shopify_attributes }}>
              <b class="mono">{{ block.settings.value }}</b>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nosotros",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Cómo trabajamos las marcas" },
    { "type": "textarea", "id": "heading", "label": "Título", "default": "Curaduría,\nno bodega" },
    { "type": "textarea", "id": "text_1", "label": "Párrafo 1", "default": "No compramos por volumen ni almacenamos temporada tras temporada. Cada marca que entra al catálogo pasa por una revisión de materiales, ajuste de tallas y tiempos reales de entrega antes de publicarse." },
    { "type": "textarea", "id": "text_2", "label": "Párrafo 2", "default": "Cuando compras, el proveedor surte directo desde su taller o almacén — nosotros coordinamos el pedido, el pago y el seguimiento, para que la prenda llegue igual de bien sin pasar por una bodega intermedia." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Dato",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Valor", "default": "7–15" },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Días de entrega" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nosotros",
      "blocks": [
        { "type": "stat", "settings": { "value": "7–15", "label": "Días de entrega" } },
        { "type": "stat", "settings": { "value": "0", "label": "Bodegas propias" } },
        { "type": "stat", "settings": { "value": "100%", "label": "Pago seguro" } }
      ]
    }
  ]
}
{% endschema %}
