<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#121214">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif %}

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    {%- if page_description %}
      <meta property="og:description" content="{{ page_description | escape }}">
    {%- endif %}
    {%- if template.name == 'product' and product.featured_image %}
      <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    {%- endif %}

    <script>
      (function () {
        var d = document.documentElement;
        d.className = d.className.replace('no-js', 'js');
        {%- if template.name == 'index' and settings.intro_enabled %}
        try { if (!sessionStorage.getItem('dropIntroSeen')) { d.classList.add('has-intro'); } } catch (e) {}
        {%- endif %}
        try { if (sessionStorage.getItem('dropVeil')) { d.classList.add('veil-arrive'); } } catch (e) {}
      })();
    </script>

    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'commerce.css' | asset_url }}">

    {{ content_for_header }}

    <script>
      window.DROP = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          cartJs: {{ routes.cart_url | append: '.js' | json }}
        },
        currency: {{ cart.currency.iso_code | json }},
        whatsapp: {
          number: {{ settings.whatsapp_number | strip | json }},
          message: {{ settings.whatsapp_message | json }}
        },
        strings: {
          added: 'Agregado al carrito',
          error: 'No se pudo actualizar el carrito. Intenta de nuevo.',
          soldOut: 'Agotado',
          add: 'Agregar al carrito',
          unavailable: 'No disponible'
        }
      };
    </script>
  </head>

  <body class="template-{{ request.page_type | handleize }}">
    <a class="skip-link" href="#MainContent">Saltar al contenido</a>

    {%- if template.name == 'index' and settings.intro_enabled -%}
      {% render 'intro' %}
    {%- endif -%}

    {% section 'header' %}

    <div class="page" id="page">
      <main id="MainContent" tabindex="-1">
        {{ content_for_layout }}
      </main>
    </div>

    {% section 'footer' %}
    {% section 'cart-drawer' %}

    {% if settings.whatsapp_enabled %}
      {% render 'whatsapp-button' %}
    {% endif %}

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    {% render 'route-veil' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
